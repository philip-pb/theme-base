{%- style -%}
  .dormio-about--{{ section.id }} {
    --d-dark: #0D1B2A;
    --d-mid: #162436;
    --d-creme: #F5F2EC;
    --d-green: #4A7C6F;
    --d-green-dark: #3A6259;
  }

  /* ── Hero ── */
  .dormio-about--{{ section.id }} .da__hero {
    background: var(--d-dark);
    padding: 96px 24px 80px;
    text-align: center;
  }
  .dormio-about--{{ section.id }} .da__eyebrow {
    font-family: Inter, sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--d-green);
    display: block;
    margin-bottom: 20px;
  }
  .dormio-about--{{ section.id }} .da__hero-heading {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: clamp(2rem, 5.5vw, 3.4rem);
    line-height: 1.15;
    color: var(--d-creme);
    max-width: 820px;
    margin: 0 auto 24px;
    font-weight: 400;
  }
  .dormio-about--{{ section.id }} .da__hero-lead {
    font-family: Inter, sans-serif;
    font-size: 1.2rem;
    line-height: 1.7;
    color: #8aaabb;
    max-width: 580px;
    margin: 0 auto;
  }

  /* ── Story blocks ── */
  .dormio-about--{{ section.id }} .da__story {
    background: #F5F2EC;
    padding: 80px 24px;
  }
  .dormio-about--{{ section.id }} .da__story-inner {
    max-width: 720px;
    margin: 0 auto;
  }
  .dormio-about--{{ section.id }} .da__chapter {
    margin-bottom: 56px;
    padding-bottom: 56px;
    border-bottom: 1px solid rgba(13,27,42,0.1);
  }
  .dormio-about--{{ section.id }} .da__chapter:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }
  .dormio-about--{{ section.id }} .da__chapter-num {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: 3.5rem;
    line-height: 1;
    color: rgba(13,27,42,0.08);
    display: block;
    margin-bottom: 8px;
  }
  .dormio-about--{{ section.id }} .da__chapter-heading {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    line-height: 1.25;
    color: var(--d-dark);
    margin: 0 0 16px;
    font-weight: 400;
  }
  .dormio-about--{{ section.id }} .da__chapter-text {
    font-family: Inter, sans-serif;
    font-size: 1.2rem;
    line-height: 1.75;
    color: #3a4a54;
    margin: 0;
  }

  /* ── Values ── */
  .dormio-about--{{ section.id }} .da__values {
    background: var(--d-mid);
    padding: 80px 24px;
  }
  .dormio-about--{{ section.id }} .da__values-inner {
    max-width: 900px;
    margin: 0 auto;
  }
  .dormio-about--{{ section.id }} .da__values-heading {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    color: var(--d-creme);
    text-align: center;
    margin: 0 0 48px;
    font-weight: 400;
  }
  .dormio-about--{{ section.id }} .da__values-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  @media screen and (min-width: 750px) {
    .dormio-about--{{ section.id }} .da__values-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .dormio-about--{{ section.id }} .da__value-card {
    background: #1E3348;
    border-radius: 12px;
    padding: 32px 28px;
    text-align: center;
  }
  .dormio-about--{{ section.id }} .da__value-icon {
    font-size: 2.2rem;
    display: block;
    margin-bottom: 16px;
  }
  .dormio-about--{{ section.id }} .da__value-title {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: 1.35rem;
    color: var(--d-creme);
    margin: 0 0 10px;
    font-weight: 400;
  }
  .dormio-about--{{ section.id }} .da__value-text {
    font-family: Inter, sans-serif;
    font-size: 1.2rem;
    line-height: 1.6;
    color: #8aaabb;
    margin: 0;
  }

  /* ── Closing ── */
  .dormio-about--{{ section.id }} .da__closing {
    background: var(--d-dark);
    padding: 80px 24px;
    text-align: center;
  }
  .dormio-about--{{ section.id }} .da__closing-inner {
    max-width: 680px;
    margin: 0 auto;
  }
  .dormio-about--{{ section.id }} .da__closing-text {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    line-height: 1.3;
    color: var(--d-creme);
    font-weight: 400;
    font-style: italic;
    margin: 0 0 32px;
  }
  .dormio-about--{{ section.id }} .da__closing-sig {
    font-family: Inter, sans-serif;
    font-size: 1.1rem;
    color: var(--d-green);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .dormio-about--{{ section.id }} .da__closing-btn {
    display: inline-block;
    margin-top: 36px;
    background: var(--d-green);
    color: #fff;
    font-family: Inter, sans-serif;
    font-size: 1.2rem;
    font-weight: 700;
    padding: 16px 36px;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .dormio-about--{{ section.id }} .da__closing-btn:hover {
    background: var(--d-green-dark);
  }
{%- endstyle -%}

<div class="dormio-about--{{ section.id }}">

  {%- comment -%} ── Hero ── {%- endcomment -%}
  <div class="da__hero">
    <span class="da__eyebrow">{{ section.settings.eyebrow | escape }}</span>
    <h1 class="da__hero-heading">{{ section.settings.hero_heading }}</h1>
    <p class="da__hero-lead">{{ section.settings.hero_lead | escape }}</p>
  </div>

  {%- comment -%} ── Story ── {%- endcomment -%}
  <div class="da__story">
    <div class="da__story-inner">
      <div class="da__chapter">
        <span class="da__chapter-num">01</span>
        <h2 class="da__chapter-heading">{{ section.settings.ch1_heading | escape }}</h2>
        <div class="da__chapter-text">{{ section.settings.ch1_text }}</div>
      </div>
      <div class="da__chapter">
        <span class="da__chapter-num">02</span>
        <h2 class="da__chapter-heading">{{ section.settings.ch2_heading | escape }}</h2>
        <div class="da__chapter-text">{{ section.settings.ch2_text }}</div>
      </div>
      <div class="da__chapter">
        <span class="da__chapter-num">03</span>
        <h2 class="da__chapter-heading">{{ section.settings.ch3_heading | escape }}</h2>
        <div class="da__chapter-text">{{ section.settings.ch3_text }}</div>
      </div>
    </div>
  </div>

  {%- comment -%} ── Values ── {%- endcomment -%}
  <div class="da__values">
    <div class="da__values-inner">
      <h2 class="da__values-heading">{{ section.settings.values_heading | escape }}</h2>
      <div class="da__values-grid">
        <div class="da__value-card">
          <span class="da__value-icon">🔬</span>
          <p class="da__value-title">Wissenschaft</p>
          <p class="da__value-text">Jede Designentscheidung basiert auf schlafmedizinischen Erkenntnissen — nicht auf Trends.</p>
        </div>
        <div class="da__value-card">
          <span class="da__value-icon">🫀</span>
          <p class="da__value-title">Gesundheit</p>
          <p class="da__value-text">Erholung ist keine Nebensache. Gesunder Schlaf ist die Grundlage für alles andere.</p>
        </div>
        <div class="da__value-card">
          <span class="da__value-icon">🤝</span>
          <p class="da__value-title">Ehrlichkeit</p>
          <p class="da__value-text">Keine erfundenen Zahlen, keine leeren Versprechen. Nur das, was wir selbst erlebt haben.</p>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} ── Closing ── {%- endcomment -%}
  <div class="da__closing">
    <div class="da__closing-inner">
      <p class="da__closing-text">{{ section.settings.closing_quote | escape }}</p>
      <span class="da__closing-sig">{{ section.settings.closing_sig | escape }}</span>
      {%- unless section.settings.cta_label == blank -%}
        <div>
          <a href="{{ section.settings.cta_url }}" class="da__closing-btn">
            {{ section.settings.cta_label | escape }}
          </a>
        </div>
      {%- endunless -%}
    </div>
  </div>

</div>

{% schema %}
{
  "name": "Dormio: Über uns",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Unsere Geschichte"
    },
    {
      "type": "inline_richtext",
      "id": "hero_heading",
      "label": "Headline",
      "default": "Je älter wir wurden, desto schlechter wurde der Schlaf."
    },
    {
      "type": "text",
      "id": "hero_lead",
      "label": "Lead-Satz",
      "default": "Dormio entstand nicht im Labor — sondern aus echten schlaflosen Nächten."
    },
    {
      "type": "header",
      "content": "Kapitel 1"
    },
    {
      "type": "text",
      "id": "ch1_heading",
      "label": "Überschrift",
      "default": "Wir haben das Problem selbst erlebt."
    },
    {
      "type": "richtext",
      "id": "ch1_text",
      "label": "Text",
      "default": "<p>Mit Anfang 30 bemerkten wir es zum ersten Mal: Die Nächte wurden unruhiger, die Morgen schwerer. Steifer Nacken, tauber Arm, dieses diffuse Gefühl, nie wirklich erholt zu sein — obwohl man acht Stunden geschlafen hatte.</p><p>Wir dachten, das gehört zum Älterwerden dazu. Das stimmt nicht.</p>"
    },
    {
      "type": "header",
      "content": "Kapitel 2"
    },
    {
      "type": "text",
      "id": "ch2_heading",
      "label": "Überschrift",
      "default": "Wir haben gesucht — und wenig Ehrliches gefunden."
    },
    {
      "type": "richtext",
      "id": "ch2_text",
      "label": "Text",
      "default": "<p>Was der Markt anbot, war enttäuschend: aufgeblasene Versprechen, teure Kissen ohne schlafmedizinische Grundlage, und unzählige Influencer-Empfehlungen ohne jede Substanz.</p><p>Also haben wir uns in die Wissenschaft eingelesen. Studien zu Schlafergonomie, Halswirbelsäulen-Biomechanik, Druckpunkten. Und dann haben wir ein Kissen gebaut, das wirklich tut, was es soll.</p>"
    },
    {
      "type": "header",
      "content": "Kapitel 3"
    },
    {
      "type": "text",
      "id": "ch3_heading",
      "label": "Überschrift",
      "default": "Dem Körper verpflichtet — nicht dem Trend."
    },
    {
      "type": "richtext",
      "id": "ch3_text",
      "label": "Text",
      "default": "<p>Dormio ist kein Lifestyle-Produkt. Es ist ein Werkzeug zur Erholung. Jede Entscheidung — Schaumhärte, Kissenform, Zonen-Aufteilung — basiert auf dem, was der Körper im Schlaf tatsächlich braucht.</p><p>Wir verkaufen keine Magie. Wir verkaufen Schlaf, der sich lohnt.</p>"
    },
    {
      "type": "header",
      "content": "Unsere Werte"
    },
    {
      "type": "text",
      "id": "values_heading",
      "label": "Überschrift",
      "default": "Was uns antreibt"
    },
    {
      "type": "header",
      "content": "Abschluss"
    },
    {
      "type": "text",
      "id": "closing_quote",
      "label": "Abschluss-Zitat",
      "default": "Guter Schlaf ist kein Luxus. Er ist das Fundament, auf dem alles andere aufbaut."
    },
    {
      "type": "text",
      "id": "closing_sig",
      "label": "Signatur",
      "default": "Das Dormio-Team"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button-Text",
      "default": "Dormio entdecken"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button-Link"
    }
  ],
  "presets": [
    {
      "name": "Dormio: Über uns"
    }
  ]
}
{% endschema %}
