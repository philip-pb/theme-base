        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Maria K., 38"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dormio: Testimonial-Wall",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
