{%- style -%}
  #dormio-sticky-atc-{{ section.id }} {
    --d-dark: #0D1B2A;
    --d-creme: #F5F2EC;
    --d-green: #4A7C6F;
    --d-green-dark: #3A6259;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 999;
    background: var(--d-dark);
    padding: 12px 20px 12px;
    padding-bottom: calc(12px + env(safe-area-inset-bottom));
    box-shadow: 0 -2px 16px rgba(0,0,0,0.2);
    transform: translateY(100%);
    transition: transform 0.3s ease;
    will-change: transform;
  }
  #dormio-sticky-atc-{{ section.id }}.is-visible {
    transform: translateY(0);
  }
  @media screen and (min-width: 1024px) {
    #dormio-sticky-atc-{{ section.id }} {
      display: none;
    }
  }
  #dormio-sticky-atc-{{ section.id }} .dsa__inner {
    max-width: 500px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  #dormio-sticky-atc-{{ section.id }} .dsa__info {
    flex: 1;
    min-width: 0;
  }
  #dormio-sticky-atc-{{ section.id }} .dsa__product {
    font-family: Inter, sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--d-creme);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  #dormio-sticky-atc-{{ section.id }} .dsa__price {
    font-family: Inter, sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    color: #8aaabb;
    margin-top: 2px;
  }
  #dormio-sticky-atc-{{ section.id }} .dsa__btn {
    flex-shrink: 0;
    background: var(--d-green) !important;
    color: #fff !important;
    font-family: Inter, sans-serif;
    font-size: 1rem !important;
    font-weight: 700;
    padding: 14px 24px;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s ease;
  }
  #dormio-sticky-atc-{{ section.id }} .dsa__btn:hover {
    background: var(--d-green-dark) !important;
  }
  #dormio-sticky-atc-{{ section.id }} .dsa__btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
{%- endstyle -%}

<div id="dormio-sticky-atc-{{ section.id }}" aria-hidden="true">
  <div class="dsa__inner">
    <div class="dsa__info">
      <div class="dsa__product">{{ section.settings.product_name | default: product.title | escape }}</div>
      <div class="dsa__price" data-sticky-price>{{ product.selected_or_first_available_variant.price | money }}</div>
    </div>
    <button type="button" class="dsa__btn" id="dormio-sticky-btn-{{ section.id }}">
      {{ section.settings.button_label | default: 'In den Warenkorb' | escape }}
    </button>
  </div>
</div>

<script>
(function() {
  var stickyBar = document.getElementById('dormio-sticky-atc-{{ section.id }}');
  var stickyBtn = document.getElementById('dormio-sticky-btn-{{ section.id }}');
  if (!stickyBar || !stickyBtn) return;

  // Show/hide based on main ATC visibility
  function watchATC() {
    var mainBtn = document.querySelector('.product-form__submit') ||
                  document.querySelector('[id^="dormio-bundle-form-"] button[type="submit"]');
    if (!mainBtn) return;

    var observer = new IntersectionObserver(function(entries) {
      var isVisible = entries[0].isIntersecting;
      stickyBar.classList.toggle('is-visible', !isVisible);
      stickyBar.setAttribute('aria-hidden', isVisible ? 'true' : 'false');
    }, { threshold: 0.1 });
    observer.observe(mainBtn);
  }

  // Update price from bundle picker selection
  function updatePrice() {
    var priceEl = stickyBar.querySelector('[data-sticky-price]');
    if (!priceEl) return;

    document.addEventListener('dormio:bundle-selected', function(e) {
      if (e.detail && e.detail.price) {
        priceEl.textContent = e.detail.price;
      }
    });

    // Also watch for Shopify variant change events
    document.addEventListener('variant:changed', function(e) {
      if (e.detail && e.detail.variant && e.detail.variant.price) {
        var cents = e.detail.variant.price;
        var formatted = 'CHF ' + (cents / 100).toFixed(2);
        priceEl.textContent = formatted;
      }
    });
  }

  // ATC click: delegate to bundle form or main form
  stickyBtn.addEventListener('click', function() {
    stickyBtn.disabled = true;
    stickyBtn.textContent = '...';

    // Try bundle form first
    var bundleForm = document.querySelector('[id^="dormio-bundle-form-"]');
    var productForm = document.querySelector('form[action="/cart/add"]');
    var targetForm = bundleForm || productForm;

    if (!targetForm) {
      stickyBtn.disabled = false;
      stickyBtn.textContent = '{{ section.settings.button_label | default: 'In den Warenkorb' | escape }}';
      return;
    }

    var variantId = null;
    var bundleInput = targetForm.querySelector('input[name="id"]');
    if (bundleInput) variantId = bundleInput.value;
    if (!variantId) {
      stickyBtn.disabled = false;
      stickyBtn.textContent = '{{ section.settings.button_label | default: 'In den Warenkorb' | escape }}';
      return;
    }

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: parseInt(variantId, 10), quantity: 1 })
    })
    .then(function(r) { return r.json(); })
    .then(function() {
      stickyBtn.textContent = '✓';
      setTimeout(function() {
        stickyBtn.disabled = false;
        stickyBtn.textContent = '{{ section.settings.button_label | default: 'In den Warenkorb' | escape }}';
      }, 1500);
      // Open cart drawer if available
      document.dispatchEvent(new CustomEvent('cart:add', { detail: { variantId: variantId } }));
    })
    .catch(function() {
      stickyBtn.disabled = false;
      stickyBtn.textContent = '{{ section.settings.button_label | default: 'In den Warenkorb' | escape }}';
    });
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() { watchATC(); updatePrice(); });
  } else {
    watchATC();
    updatePrice();
  }
})();
</script>

{% schema %}
{
  "name": "Dormio: Sticky ATC",
  "tag": "section",
  "class": "section",
  "limit": 1,
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "text",
      "id": "product_name",
      "label": "Produktname (leer = Produkttitel)",
      "info": "Kurz halten — z.B. \"Dormio Ergokissen\""
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button-Text",
      "default": "In den Warenkorb"
    }
  ],
  "presets": [{ "name": "Dormio: Sticky ATC" }]
}
{% endschema %}
