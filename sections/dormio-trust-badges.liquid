{%- style -%}
  .dormio-trust-badges {
    --d-dark: #0D1B2A;
    --d-creme: #F5F2EC;
    --d-green: #4A7C6F;
    --d-green-pale: #E8F0EE;
    background: var(--d-dark);
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .dormio-trust-badges {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .dormio-trust-badges__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 24px;
    list-style: none;
    margin: 0;
    padding: 0 16px;
    max-width: 900px;
    margin-inline: auto;
  }
  .dormio-trust-badges__item {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--d-creme);
    font-family: Inter, sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    white-space: nowrap;
  }
  .dormio-trust-badges__icon {
    width: 20px;
    height: 20px;
    color: var(--d-green);
    flex-shrink: 0;
  }
  .dormio-trust-badges__divider {
    color: #2E4560;
  }
  @media screen and (max-width: 749px) {
    .dormio-trust-badges__list {
      gap: 10px 16px;
    }
    .dormio-trust-badges__item {
      font-size: 0.8rem;
    }
  }
{%- endstyle -%}

<div class="dormio-trust-badges">
  <ul class="dormio-trust-badges__list" role="list">
    {%- for block in section.blocks -%}
      {%- if forloop.index > 1 -%}
        <li class="dormio-trust-badges__divider" aria-hidden="true">·</li>
      {%- endif -%}
      <li class="dormio-trust-badges__item" {{ block.shopify_attributes }}>
        {%- case block.settings.icon -%}
          {%- when 'shield' -%}
            <svg class="dormio-trust-badges__icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>
            </svg>
          {%- when 'truck' -%}
            <svg class="dormio-trust-badges__icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>
            </svg>
          {%- when 'return' -%}
            <svg class="dormio-trust-badges__icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3"/>
            </svg>
          {%- when 'star' -%}
            <svg class="dormio-trust-badges__icon" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354l-4.502 2.825c-.995.608-2.23-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005z"/>
            </svg>
          {%- else -%}
            <svg class="dormio-trust-badges__icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4.5 12.75l6 6 9-13.5"/>
            </svg>
        {%- endcase -%}
        <span>{{ block.settings.label }}</span>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Dormio: Trust-Badges",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Abstände"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 8,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 8,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Schild (Garantie)" },
            { "value": "truck", "label": "LKW (Versand)" },
            { "value": "return", "label": "Pfeil (Rückgabe)" },
            { "value": "star", "label": "Stern (Bewertung)" },
            { "value": "check", "label": "Haken" }
          ],
          "default": "shield"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Text",
          "default": "60 Nächte Garantie"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dormio: Trust-Badges",
      "blocks": [
        {
          "type": "badge",
          "settings": { "icon": "shield", "label": "60 Nächte Garantie" }
        },
        {
          "type": "badge",
          "settings": { "icon": "truck", "label": "3–5 Tage Lieferung" }
        },
        {
          "type": "badge",
          "settings": { "icon": "return", "label": "Gratis Rückversand" }
        },
        {
          "type": "badge",
          "settings": { "icon": "star", "label": "4.8/5 · 2.400+ Bewertungen" }
        }
      ]
    }
  ]
}
{% endschema %}
