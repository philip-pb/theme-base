{%- style -%}
  .dormio-final-cta--{{ section.id }} {
    --d-dark: #0D1B2A;
    --d-mid: #162436;
    --d-creme: #F5F2EC;
    --d-green: #4A7C6F;
    --d-green-dark: #3A6259;
    background: var(--d-dark);
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .dormio-final-cta--{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .dormio-final-cta--{{ section.id }} .dfcta__inner {
    max-width: 680px;
    margin-inline: auto;
    padding: 0 24px;
    text-align: center;
  }
  .dormio-final-cta--{{ section.id }} .dfcta__heading {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: clamp(1.7rem, 5vw, 2.4rem);
    line-height: 1.2;
    color: var(--d-creme);
    margin: 0 0 16px;
  }
  .dormio-final-cta--{{ section.id }} .dfcta__subtext {
    font-family: Inter, sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    color: #8aaabb;
    margin: 0 0 28px;
  }
  .dormio-final-cta--{{ section.id }} .dfcta__price-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }
  .dormio-final-cta--{{ section.id }} .dfcta__price {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: 2rem;
    color: var(--d-creme);
  }
  .dormio-final-cta--{{ section.id }} .dfcta__compare {
    font-family: Inter, sans-serif;
    font-size: 1rem;
    color: #8aaabb;
    text-decoration: line-through;
  }
  .dormio-final-cta--{{ section.id }} .dfcta__badge {
    background: #c0824a;
    color: #fff;
    font-family: Inter, sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 20px;
  }
  .dormio-final-cta--{{ section.id }} .dfcta__btn {
    display: inline-block;
    background: var(--d-green);
    color: #fff;
    font-family: Inter, sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    padding: 16px 40px;
    border-radius: 8px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: background 0.2s ease;
    width: 100%;
    max-width: 380px;
  }
  .dormio-final-cta--{{ section.id }} .dfcta__btn:hover {
    background: var(--d-green-dark);
  }
  .dormio-final-cta--{{ section.id }} .dfcta__guarantee {
    font-family: Inter, sans-serif;
    font-size: 0.82rem;
    color: #8aaabb;
    margin: 14px 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }
  .dormio-final-cta--{{ section.id }} .dfcta__guarantee-icon {
    width: 16px;
    height: 16px;
    color: var(--d-green);
    flex-shrink: 0;
  }
{%- endstyle -%}

<div class="dormio-final-cta--{{ section.id }}">
  <div class="dfcta__inner">
    {%- unless section.settings.heading == blank -%}
      <h2 class="dfcta__heading">{{ section.settings.heading }}</h2>
    {%- endunless -%}
    {%- unless section.settings.subtext == blank -%}
      <p class="dfcta__subtext">{{ section.settings.subtext }}</p>
    {%- endunless -%}

    <div class="dfcta__price-row">
      {%- unless section.settings.price == blank -%}
        <span class="dfcta__price">{{ section.settings.price | escape }}</span>
      {%- endunless -%}
      {%- unless section.settings.compare_price == blank -%}
        <span class="dfcta__compare">{{ section.settings.compare_price | escape }}</span>
      {%- endunless -%}
      {%- unless section.settings.discount_badge == blank -%}
        <span class="dfcta__badge">{{ section.settings.discount_badge | escape }}</span>
      {%- endunless -%}
    </div>

    {%- if product != blank -%}
      <a href="{{ product.url }}?scrollToCart=1" class="dfcta__btn" id="dormio-final-atc-{{ section.id }}">
        {{ section.settings.button_label | escape }}
      </a>
    {%- else -%}
      <a href="#" class="dfcta__btn">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}

    {%- unless section.settings.guarantee_text == blank -%}
      <p class="dfcta__guarantee">
        <svg class="dfcta__guarantee-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>
        </svg>
        {{ section.settings.guarantee_text | escape }}
      </p>
    {%- endunless -%}
  </div>
</div>

{% schema %}
{
  "name": "Dormio: Final-CTA",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Überschrift",
      "default": "Bereit für deinen ersten erholten Morgen?"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Untertext",
      "default": "Über 2.400 Kunden schlafen bereits besser. Jetzt bist du dran."
    },
    {
      "type": "header",
      "content": "Preis-Anzeige"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Preis",
      "default": "CHF 89"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Streichpreis",
      "default": "CHF 129"
    },
    {
      "type": "text",
      "id": "discount_badge",
      "label": "Rabatt-Badge",
      "default": "−31%"
    },
    {
      "type": "header",
      "content": "Button & Garantie"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button-Text",
      "default": "Jetzt bestellen — CHF 89"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Garantie-Text",
      "default": "60 Nächte testen — Gratis Rückversand — Kein Risiko"
    },
    {
      "type": "header",
      "content": "Abstände"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Dormio: Final-CTA"
    }
  ]
}
{% endschema %}
